-- ============================================================================
-- AUXILIARY PERCUSSION — the keys on channel 9, one line each
-- ============================================================================
--
-- Channel 9 on the JV-1010 is split by key. Up to B2 (47) it is the Concert BD1
-- patch (part 9): note 36 is the bass drum. From C3 (48) it is the rhythm part
-- (part 10, the user rhythm set OrchDrumSet), one instrument per key with its
-- own level and pan. Evaluate a line to hear a key; `# amp` sets the dynamic
-- (pppp 0.25, p 0.40, f 0.65).
--
-- Positions are from the conductor: negative left, positive right.

once $ midinote 36 # ch 9 # sustain 0.05 # amp 0.65   -- bass drum (Concert BD1 patch), slightly right

once $ midinote 54 # ch 9 # sustain 0.05 # amp 0.65   -- tambourine, right
once $ midinote 76 # ch 9 # sustain 0.05 # amp 0.65   -- woodblock, right
once $ midinote 81 # ch 9 # sustain 0.3  # amp 0.65   -- triangle, far left

once $ midinote 57 # ch 9 # sustain 0.05 # amp 0.65   -- crash: the Orchestral board's Piatti, ringing its own length; slightly left
once $ midinote 59 # ch 9 # sustain 0.05 # amp 0.65   -- ride: the set's own ride cymbal; left
once $ midinote 84 # ch 9 # sustain 0.05 # amp 0.65   -- wind chimes: the board's; left

once $ midinote 60 # ch 9 # sustain 0.05 # amp 0.65   -- snare, stroke (the board's soft sample)
once $ midinote 61 # ch 9 # sustain 0.05 # amp 0.65   -- snare, stroke (the board's loud sample)
once $ midinote 62 # ch 9 # sustain 0.05 # amp 0.65   -- snare, accent
once $ midinote 63 # ch 9 # sustain 2    # amp 0.65   -- snare roll: lasts as long as the note
once $ midinote 64 # ch 9 # sustain 0.05 # amp 0.65   -- side stick (the set's own)

-- a bar of everything
d1 $ stack
  [ midinote "36 ~ ~ ~ 36 ~ ~ ~" # sustain 0.05
  , midinote "~ ~ 60 ~ ~ 60 62 ~" # sustain 0.05
  , midinote "~ ~ ~ ~ ~ ~ ~ 63" # sustain 0.4
  , midinote "57 ~ ~ ~ ~ ~ ~ ~" # sustain 0.05
  , midinote "~ 59 ~ 59 ~ 59 ~ 59" # sustain 0.05 # amp 0.4
  ] # ch 9

hush
