-- ============================================================================
-- JV-1010 PART LEVELS — the calibrated balance, as channel volume
-- ============================================================================
--
-- The JV's balance is the part levels of the Performance stored on the module
-- (JV_PERFORMANCE_EDITS.md); this table is the same numbers. CC7 on a
-- Performance part replaces its level until the Performance is selected again,
-- so evaluating the `once` lines puts the balance back after anything has
-- moved a channel's volume, without touching the module.
--
-- It restores levels only. The dynamic response lives in the patches.
--
-- JV channels: 1 flute, 2 oboe, 3 clarinet, 4 bassoon, 5 horn, 6 trombone +
-- bass trombone, 7 harp (continuo), 8 timpani, 9 percussion, 10 the MPC lane
-- (not the JV), 11 tam-tam, 12 pizz, 13 spicc, 14 marc, 15 legg, 16 arco.
--
-- Channel 9 has no row. Two parts listen on it at different levels — the bass
-- drum (93) and the rhythm part with the auxiliary percussion (107) — and one
-- CC7 would set both to the same value. Selecting the Performance again
-- (or a power cycle) restores them.

jvLevel :: [(Int, Double)]
jvLevel = [ (c, (l + 0.25) / 127) | (c, l) <-      -- a quarter step up: the 0-127 value survives truncation and rounding alike
  [ ( 1,  53)   -- flute
  , ( 2,  67)   -- oboe
  , ( 3,  92)   -- clarinet
  , ( 4,  71)   -- bassoon
  , ( 5,  88)   -- horn
  , ( 6, 107)   -- trombone, bass trombone
  , ( 7,  50)   -- harp, the continuo
  , ( 8, 127)   -- timpani
  , (11,  40)   -- tam-tam
  , (12, 107)   -- strings pizzicato
  , (13,  89)   -- strings spiccato
  , (14,  87)   -- strings marcato
  , (15,  83)   -- strings legato
  , (16,  56)   -- strings arco
  ] ]

-- Send the table (CC7), then open expression (CC11) on every channel: the
-- pieces leave CC11 where their ramps ended.
once $ nanoTable 7 jvLevel

once $ nanoTable 11 [ (c, 1) | c <- [1..16] ]
