#!/bin/zsh
# Launch the live rig: editor, SuperCollider, and the Q-Link controller bridge.
#
# The three start in a fixed order because each waits on the one before it.
# Pulsar starts SuperCollider itself (superDirt.autostart), SuperCollider
# writes an `sc_ready` stamp once SuperDirt is up and MIDI is bound, and only
# then can the Q-Link bridge be injected — it needs a running interpreter to
# receive it. Injecting early is silent: the OSC lands nowhere and the encoders
# do nothing.
#
# Ctrl-C stops the session and takes Pulsar with it.
#
#   livecode            launch everything
#   livecode --attach   inject the bridge into a SuperCollider that is already
#                       running, and monitor; leaves the editor alone
#
# GHCRTS is NOT set here. It rides on live/bin/ghci, so it applies whether the
# session is launched from this script or from Pulsar directly.
#
# No `set -e`: `kill` and `wait` on an already-exited child return non-zero,
# which would abort the cleanup trap before it reports. Failures that matter
# are checked where they happen.

live=${0:A:h:h}
PULSAR=${PULSAR:-/Applications/Pulsar.app/Contents/MacOS/Pulsar}
attach=0
if [[ "$1" == "--attach" ]]; then
  attach=1
fi

clear && cd "$live" || exit 1

if (( attach )); then
  cleanup() { echo "\nStopped."; }
  trap cleanup EXIT INT TERM
else
  "$PULSAR" . > /dev/null 2>&1 &
  pulsar_pid=$!

  cleanup() { kill $pulsar_pid 2>/dev/null; wait $pulsar_pid 2>/dev/null; echo "\nStopped."; }
  trap cleanup EXIT INT TERM
fi

# Removed first so a stamp from a previous session cannot be mistaken for this
# one; superdirt_startup.scd writes it as its last act.
ready_file="$HOME/Library/Application Support/SuperCollider/sc_ready"

if (( ! attach )); then
  rm -f "$ready_file"
  echo "Waiting for SuperCollider (boot TidalCycles in Pulsar)..."
  while [[ ! -f "$ready_file" ]]; do
    kill -0 $pulsar_pid 2>/dev/null || { echo "Pulsar exited."; exit 1; }
    sleep 2
  done
fi

# Pushed in through the /run-code OSC backdoor superdirt_startup.scd opens on
# 57121, rather than loaded at startup, so the bridge can be re-injected
# mid-session without restarting the server.
# OSC is fire-and-forget UDP, so a successful send proves only that the file
# was read and the datagram left — never that SuperCollider heard it. What this
# does catch is a missing or unreadable qlink-bridge.scd, which otherwise leaves
# the monitor loop painting a status line nothing will ever write to.
if ! python3 osc-send.py localhost 57121 /run-code s --file qlink-bridge.scd; then
  echo "Could not send qlink-bridge.scd — check the file is readable."
  exit 1
fi
clear && echo "Q-Link bridge active. Monitoring encoders (Ctrl-C to stop)..."

# qlink-bridge.scd writes a formatted encoder read-out to this file; the loop
# paints it in place so the terminal doubles as a controller display.
status_file="$HOME/Library/Application Support/SuperCollider/sc_status.line"
touch "$status_file"
while (( attach )) || kill -0 $pulsar_pid 2>/dev/null; do
  printf "\r%s" "$(cat "$status_file" 2>/dev/null)"
  sleep 0.05
done
