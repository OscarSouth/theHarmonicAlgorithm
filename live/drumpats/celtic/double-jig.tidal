 -- DOUBLE JIG  (celtic)                           -- 6/8 compound, six eighths  [eighth = pulse]
 -- accent beats 1 & 4 (the two dotted-quarters); bodhrán boom on 0,3 + running 8ths.
 -- accent: kick (1 & 4).   ·   ~120-135 BPM · straight · 6/8
 -- ── TRIGGERS ──  raw grids (highlight-visible, reusable gates)
(kickseq, snareseq, clapseq, chseq, ohseq, hhseq, rideseq, percseq) =
  ( "[[1 0 0 1 0 0]]/6"                            -- kick (0,3 dotted-qtrs)
  , "[[0 0 1 0 0 1]]/6"                            -- snare (the '&' cracks)
  , silence                                        -- clap
  , "[[1 1 1 1 1 1]]/6"                            -- hh (all 6 eighths)
  , silence                                        -- open
  , "[[1 1 1 1 1 1]]/6"                            -- combined
  , silence                                        -- ride
  , silence                                        -- perc
  )
 -- ── AMPS ──  dynamics (Pattern Double; leading-zero decimals)
(kickamp, snareamp, clapamp, hhamp, rideamp, percamp) =
  ( "1 0.9"               -- kick
  , 1                     -- snare
  , 1                     -- clap
  , 1                     -- hats
  , 1                     -- ride
  , 1                     -- perc
  )
 -- ── PATTERNS ──  enriched (trigger × role-vel × amp) — the core version
(kickpat, snarepat, clappat, chpat, ohpat, hhpat, ridepat, percpat, rhythm) =
  ( kick  kickseq  |* vel 1.0  |* vel kickamp
  , snare snareseq |* vel 0.9  |* vel snareamp |+ humanise 0.08
  , snap  clapseq  |* vel 0.8  |* vel clapamp
  , hhcl  chseq    |* vel 0.25 |* vel hhamp
  , hhop  ohseq    |* vel 0.25 |* vel hhamp
  , hh    hhseq    |* vel 0.5  |* vel hhamp
  , ride  rideseq  |* vel 0.4  |* vel rideamp
  , click percseq  |* vel 0.35 |* vel percamp
  , kickseq )

 -- ── PRELOADED INTERFACE ──
kgrv f k d = p "grooveKit"
  $ f
  $ stack [silence
    ,kickpat ,snarepat ,clappat ,hhpat ,ridepat ,percpat
 -- ,chpat ,ohpat   -- (separate closed/open; alt to combined hhpat)
    ]# ch 9 |* vel d
