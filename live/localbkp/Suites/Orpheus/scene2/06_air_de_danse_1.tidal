-- ============================================================================
-- VI. AIR DE DANSE 1 — ORPHEUS SINGS TO HADES
-- ============================================================================
--
-- Super-structure position: 1/2 (Development) — Orpheus's song; the
-- midpoint plea that tames hell.
--
-- From the myth: Having subdued the Furies through his approach, Orpheus now
-- sings directly to the lords of the underworld — Hades and Persephone —
-- pleading for Eurydice's return. This is the moment where art confronts
-- death, where music attempts what nothing else can.
--
-- Stravinsky writes what many consider the ballet's finest passage: a
-- "masterclass in neoclassical counterpoint." Two oboes interweave in a
-- "highly ornamented, mournful duet" while the harp plays steady rhythmic
-- plucks -- the lyre accompanying the song. The passage evokes "the slow
-- movement of a late Baroque concerto" and echoes "a Bach Passion aria."
-- An English horn joins to create a trio of double reeds. Strings enter
-- softly to provide "a warm, humanizing pad beneath the reedy plea."
--
-- The movement achieves "extreme transparency" -- every voice audible, every
-- interval meaningful. It is Orpheus's greatest musical achievement within
-- the ballet: not passionate outpouring but formal perfection, the Apollonian
-- ideal of music as mathematical persuasion.
--
-- Reimagination: E minor in G major key area. Consonant drift with ascending
-- bass motion (the plea rises). Bach-dominant blend for contrapuntal gravity.
-- Oboe-led texture with harp accompaniment. Low entropy for formal control.
-- ============================================================================

tempo = 64

start <- lead "E min"

let ctx = consonant
        $ hcRoots "E B D rise"
        $ hcKey "1#"
        $ hContext

s <- seek "bach:70 debussy:30" $ cue start $ tonal ctx $ len 8 $ entropy 0.2 $ attempt 2 6 $ gen

-- Form: ~157s loop (147s music + 10s silence)
-- Arc: transparent plea -> deepens -> strings enter -> climax subsides -> verdict awaited
form =
  [ at    0    0.0   0.0   s     -- silence
  , at    5    0.3   0.3   s     -- oboe duet + harp: extreme transparency
  , at   33    0.4   0.4   s     -- English horn joins: trio of reeds
  , at   63    0.45  0.5   s     -- strings enter softly: warm humanising pad
  , at   93    0.4   0.4   s     -- plea climax subsides
  , at  127    0.2   0.2   s     -- conclusion: awaiting the verdict
  , at  147    0.0   0.0   s     -- silence
  , at  157    0.0   0.0   s     -- silence gap
  ]

-- ── MOTIFS ───────────────────────────────────────────────
-- The Siciliana. Stravinsky's reduced forces here are exact: harp, timpani,
-- strings and an oboe duet, in late-Baroque concerto manner. The song is a
-- lilting compound cell; the second reed answers it in canon at a lower
-- pitch (the cor anglais of the score, taken here by the darker oboe line).
(rhythm, contour, motif) =
  ( "[1 0 1 1 0 1]/4"          -- siciliana lilt, compound
  , "[3 2 3 1 0 1]/4"          -- the song
  , rhythm >:< contour
  ) :: (Pattern Bool, Pattern Int, Pattern Int)

-- ── ORCHESTRAL BLOCKS ───────────────────────────────────

-- Orpheus's song: the oboe duet. First oboe states the cell; the second
-- answers a bar later in inversion — the canonic conversation of the score.
-- (The score's cor anglais is voiced as the lower oboe line: same reed
-- colour, a fifth down, which is what the canon needs.)
wind f k d = p "wind" $ do
  let vl = voiceLines {_vl = "~"
        , soprano = motif
        , tenor   = mirror 2 contour   -- the answering reed, inverted
        }
  f
    $ stack [silence
        , oboe T (0, 1)    k vl flow Soprano
        , oboe T (0.3, 1)  k vl flow Tenor
    ] |* vel d

-- The lyre: harp in canonic conversation with the lower reed. Present
-- throughout — this is Orpheus singing, and the harp is his voice.
perc f k d = p "perc" $ do
  let vl = voiceLines {_vl = "~"
        , tenor = motif
        , bass  = "0"
        }
  f
    $ stack [silence
        , harp T (0, 1) k vl flow Tenor
    ] |* vel d

-- Timpani: the Siciliana's soft tread. Named in Stravinsky's reduced forces
-- and previously missing here; kept quiet and low, entering after the song.
timp f k d = p "timp" $ do
  let vl = voiceLines {_vl = "~"
        , bass = "0"
        }
  f
    $ stack [silence
        , timpani T (0.35, 0.9) k vl grid Bass
    ] |* vel d

-- Strings: a warm pad beneath, thinning again before the close so the reeds
-- and harp are left exposed at the end.
strg f k d = p "strg" $ do
  let vl = voiceLines {_vl = "~"
        , soprano = "3"
        , alto    = "1"
        , bass    = "0"
        }
  f
    $ stack [silence
        , violin1 T (0.4, 0.9) k vl flow Soprano   # legg
        , viola   T (0.4, 0.9) k vl flow Alto      # legg
        , cello   T (0.3, 1)   k vl grid Bass8vb
    ] |* vel d

-- ── LAUNCHER ────────────────────────────────────────────

do
  let
    f = id
    d = (* 1)
    k = iK tempo form (warp "[1 2 3 4]/8")
  putStrLn "ORPHEUS — VI. Air de danse 1 (Orpheus sings to Hades)"
  mapM_ id [hush, setbpm tempo
    ,setContinuo harpV
    ,wind f k  $ d 0.9
    ,perc f k  $ d 0.85
    ,timp f k  $ d 0.45
    ,strg f k  $ d 0.55
    ]

hush''
