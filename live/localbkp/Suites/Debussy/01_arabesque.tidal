        ,"[-15,-8]@6 [-8,-3,1,4]@18"               -- b.42: [a2 e3] [e3 a3 cs4 e4]
        ,"-1@3 1@3 2@18"                           -- b.43: b3 cs4 d4
        ,"[-6,1]@6 [-13,-3]@12 [-15,-9]@6"         -- b.44: [fs3 cs4] [b2 a3] [a2 ds3]
        ,"[-16,-8]@6 [-18,-8]@12 [-25,-13]@6"      -- b.45: [gs2 e3] [fs2 e3] [b1 b2]
        ,"[-20,-13]@12 -20@6 -8@6"                 -- b.46: [e2 b2] e2 e3
        ])
     ,harp' M 1 "p" k (staff 84   -- lower staff, voice 2
        ["~@4"                                     -- b.26
        ,"~@4"                                     -- b.27
        ,"~@4"                                     -- b.28
        ,"~@4"                                     -- b.29
        ,"~@4"                                     -- b.30
        ,"~@4"                                     -- b.31
        ,"~@4"                                     -- b.32
        ,"~@4"                                     -- b.33
        ,"~@4"                                     -- b.34
        ,"~@4"                                     -- b.35
        ,"~@4"                                     -- b.36
        ,"~@4"                                     -- b.37
        ,"~@4"                                     -- b.38
        ,"6@3 ~"                                   -- b.39: fs4
        ,"~@4"                                     -- b.40
        ,"~ [-4,2]@3"                              -- b.41: [gs3 d4]
        ,"~@4"                                     -- b.42
        ,"6@3 5"                                   -- b.43: fs4 f4
        ,"~@4"                                     -- b.44
        ,"~@4"                                     -- b.45
        ,"~@4"                                     -- b.46
        ])
     ]
   -- mosso: two surges, p cresc. to f (49, 53–54), rit. in 50.
