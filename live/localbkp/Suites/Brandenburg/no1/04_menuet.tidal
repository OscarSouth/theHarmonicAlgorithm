-- ============================================================================
-- BRANDENBURG CONCERTO NO. 1 IN F MAJOR, BWV 1046 — IV. MENUET
-- J. S. Bach (compiled 1721)
-- ============================================================================
--
-- Super-structure position: 1/6 (Establishing, close) — the dance-suite
-- appendix, unique in the set.
--
-- The only four-movement concerto in the set. The finale is a regal
-- Menuet with alternating trio sections: Menuet – Trio I – Menuet –
-- Polacca – Menuet – Trio II – Menuet. The Menuet proper features muted
-- strings contrasting with oboe-horn fanfares. Trio I uses paired oboes,
-- the Polacca adds a folk-dance character, and Trio II features bassoon
-- and strings in intimate dialogue.
--
-- Adaptation: The alternating sections are encoded as kinetics shifts —
-- Menuet sections at 0.5-0.6 (full forces), Trios at 0.3-0.4 (reduced).
-- ============================================================================

tempo = 96

start <- lead "F maj"

let ctx = hcKey "1b"
        $ hContext

s <- seek "bach" $ cue start $ tonal ctx $ len 8 $ entropy 0.2 $ attempt 2 6 $ gen

-- Form: ~370s loop (360s music + 10s silence)
-- Arc: Menuet -> Trio I -> da capo -> Polacca -> da capo -> Trio II ->
--      grandest Menuet -> winding down
form =
  [ rh    1    0.0   0.0   s
  , rh    3    0.5   0.5   s     -- Menuet: full forces, regal
  , rh   21    0.35  0.35  s     -- Trio I: paired oboes, intimate
  , rh   37    0.55  0.55  s     -- Menuet da capo
  , rh   53    0.4   0.4   s     -- Polacca: folk-dance character
  , rh   71    0.55  0.55  s     -- Menuet da capo
  , rh   87    0.3   0.3   s     -- Trio II: bassoon + strings
  , rh  105    0.6   0.6   s     -- Final Menuet: grandest statement
  , rh  125    0.4   0.4   s     -- winding down
  , rh  141    0.2   0.2   s     -- closing
  , rh  145    0.0   0.0   s
  , rh  149    0.0   0.0   s     -- gap
  ]

-- ── ORCHESTRAL BLOCKS ───────────────────────────────────

menuet f k d = p "menuet" $ do
  let vl = voiceLines {_vl = "~"
        , soprano = "[3 2 3 0]/4", alto = "[1 0 1 2]/4", bass = "0"
        }
  f $ stack [silence
        , horn T (0.3, 1) k vl flow Soprano, oboe T (0.3, 1) k vl flow Alto
        , violin1 T (0, 1) k vl flow Soprano # legg, violin2 T (0.2, 1) k vl flow Alto # legg
        , viola T (0.2, 1) k vl flow Tenor # legg
        , cello T (0, 1) k vl grid Bass # legg, contrabass T (0, 1) k vl grid Bass8vb # legg
    ] |* vel d

trio f k d = p "trio" $ do
  let vl = voiceLines {_vl = "~"
        , soprano = "[3 2 3 1]/4", alto = "[1 0 1 2]/4", bass = "0"
        }
  f $ stack [silence
        , oboe T (0, 1) k vl flow Soprano, bassoon T (0.2, 1) k vl flow Bass
        , viola T (0, 1) k vl flow Alto # legg, cello T (0, 1) k vl grid Bass # legg
    ] |* vel d

continuo f k d = p "continuo" $ do
  let vl = voiceLines {_vl = "~", alto = "[1 0 2 1]/4"}
  f $ stack [silence, harp T (0, 1) k vl flow Alto] |* vel d

-- ── LAUNCHER ────────────────────────────────────────────

do
  let
    f = id; d = (* 1); k = iK tempo form (rep s 1)
  putStrLn "BRANDENBURG NO. 1 — IV. Menuet"
  mapM_ id [hush, setbpm tempo
    ,setContinuo harpsichordV
    ,menuet f k $ d 0.8, trio f k $ d 0.7, continuo f k $ d 0.6]

hush''
