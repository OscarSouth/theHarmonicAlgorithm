-- ============================================================================
-- BRANDENBURG CONCERTO NO. 4 IN G MAJOR, BWV 1049 — III. PRESTO
-- J. S. Bach (compiled 1721)
-- ============================================================================
--
-- Super-structure position: 4/6 (The Swerve, approaching golden ratio) —
-- the fugal presto.
--
-- The Presto returns the violin to prominence with brilliant virtuosic
-- writing — rapid scales and bariolage passages of extraordinary agility.
-- A fugal subject emerges, taken up by each voice. The recorders maintain
-- their pastoral quality even at speed. The movement ends with
-- exhilarating drive and rhythmic precision.
-- ============================================================================

tempo = 138

start <- lead "G maj"

let ctx = hcKey "1#"
        $ hContext

s <- seek "bach" $ cue start $ tonal ctx $ len 8 $ entropy 0.3 $ attempt 2 6 $ gen

-- Form: ~320s loop (310s music + 10s silence)
-- Arc: violin subject -> recorders enter -> full exposition -> episode ->
--      stretto (peak) -> episode -> final return
form =
  [ rh    1    0.0   0.0   s
  , rh    3    0.5   0.5   s     -- fugue subject: violin
  , rh   24    0.55  0.55  s     -- recorders enter
  , rh   47    0.6   0.6   s     -- full exposition
  , rh   76    0.4   0.4   s     -- episode
  , rh   99    0.65  0.65  s     -- stretto: peak
  , rh  127    0.45  0.45  s     -- episode
  , rh  151    0.6   0.6   s     -- final return
  , rh  179    0.0   0.0   s
  , rh  185    0.0   0.0   s     -- gap
  ]

-- ── MOTIFS ───────────────────────────────────────────────
-- The fugal subject of the presto. Violin states it; the recorders answer,
-- the second inverted. Stretto stacks them at the peak.
(rhythm, contour, motif) =
  ( "[1 1 0 1 1 0 1 1]/4"
  , "[3 1 2 0 3 2 1 0]/4"
  , rhythm >:< contour
  ) :: (Pattern Bool, Pattern Int, Pattern Int)

-- ── ORCHESTRAL BLOCKS ───────────────────────────────────

soloViolin f k d = p "solo" $ do
  let vl = voiceLines {_vl = "~", soprano = motif}
  f $ stack [silence, violin1 T (0, 1) k vl flow Soprano # spicc] |* vel d

recorders f k d = p "recorders" $ do
  let vl = voiceLines {_vl = "~", soprano = "[3 2 3 1]/4", alto = "[1 0 1 2]/4"}
  f $ stack [silence, flute T (0.15, 1) k vl flow Alto, oboe T (0.2, 1) k vl flow Tenor] |* vel d

ripieno f k d = p "strg" $ do
  let vl = voiceLines {_vl = "~", alto = "[1 2 1 0]/4", tenor = "2", bass = "0"}
  f $ stack [silence, violin2 T (0.45, 1) k vl flow Alto # spicc, viola T (0.45, 1) k vl flow Tenor # spicc
        , cello T (0, 1) k vl grid Bass # marc, contrabass T (0, 1) k vl grid Bass8vb # marc] |* vel d

continuo f k d = p "continuo" $ do
  let vl = voiceLines {_vl = "~", alto = "[1 0 2 1]/4"}
  f $ stack [silence, harp T (0, 1) k vl flow Alto] |* vel d

-- ── LAUNCHER ────────────────────────────────────────────

do
  let
    f = id; d = (* 1); k = iK tempo form (rep s 1)
  putStrLn "BRANDENBURG NO. 4 — III. Presto"
  mapM_ id [hush, setbpm tempo
    ,setContinuo harpsichordV
    ,soloViolin f k $ d 0.85, recorders f k $ d 0.7, ripieno f k $ d 0.65, continuo f k $ d 0.55]

hush''
