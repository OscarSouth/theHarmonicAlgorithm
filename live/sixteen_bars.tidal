-- ══════════════════════════════════════════════════════════
-- Sixteen Bars for Two Hands
-- ══════════════════════════════════════════════════════════
-- A ballad written in correspondence: generated by the machine,
-- curated by ear, one prompt at a time (chat session, 2026-08-20).
-- Electric piano, channel 7. 72 bpm. Whole-bar harmonic rhythm.
--
-- Form: || A (8, in Bb) | B (8, to Db via Ab7, home via F7) ||
-- cycling — the wrap IS the resolution (F7 → Bb at the top).
--
-- Requires live/BootTidal.hs booted, Neo4j up for the generative
-- recipe (the frozen piece below needs no database).

hush

tempo = 72

-- ══════════════════════════════════════════════════════════
-- THE RECIPE (stochastic — every run writes a NEW sixteen bars)
-- ══════════════════════════════════════════════════════════
-- Three gestures:
--   A: gen4 in Bb major (key 2b), low entropy — cadence-hungry,
--      falling-fifth-loving, every bar a true 4-note sonority.
--   B: cued on a HAND-DECLARED Ab7 (lead' — the aberration
--      channel), generated inside Db major (key 5b). The pivot
--      is human; the continuation is corpus.
--   Turnaround: regenerate the last two bars with roots pinned
--      to C and F under the home key — the machine must end on
--      something dominant-shaped pointing at Bb.

startA <- lead "Bb maj"
sA <- seek "*" $ cue startA $ tonal (hcKey "2b" $ hContext) $ len 8 $ entropy 0.25 $ attempt 3 8 $ gen4

startB <- lead' "Ab C Eb Gb"
sB <- seek "*" $ cue startB $ tonal (hcKey "5b" $ hContext) $ len 8 $ entropy 0.3 $ attempt 3 8 $ gen4

sAB = fuse [sA, sB]

sFin <- seek "*" $ tonal (hcRoots "c f" $ hcKey "2b" $ hContext) $ entropy 0.2 $ genFrom sAB 15 16

-- ══════════════════════════════════════════════════════════
-- THE PIECE (frozen — the canonical curated take, "V3")
-- ══════════════════════════════════════════════════════════
-- Curation applied to the first take: bars 12-14 regenerated
-- inside the flat key for motion; bar 8 hand-darkened to D 7
-- (secondary dominant into Ab7); bar 15 regenerated with roots
-- pinned to C (the true ii); bar 16 hand-spliced B 7 (tritone
-- sub) so the wrap resolves chromatically B7 -> Bb.
--
--    1  ||  Bb add11  |  Bb 6       |  Eb add9       |  Eb sus2#11 |
--    5   |  Eb add9   |  Eb add9    |  Eb 6sus2      |  D 7        |
--    9   |  Ab 7      |  Db add11   |  Gb 6b5        |  Bb sus2/4#5|
--   13   |  Gb #11    |  F m#5b9    |  C m6add11no5  |  B 7        ||
-- (The frozen form prints bars 10 and 13 sharp-side (C#, F#) —
--  hand material infers independently at root changes; see the
--  enharmonic note at the foot. Generated walks under a declared
--  key spell correctly.)

sixteen = fromChords
  [ [10,2,3,5],  [10,2,5,7],  [3,5,7,10],  [3,5,9,10]
  , [3,5,7,10],  [3,5,7,10],  [3,5,10,0],  [2,6,9,0]
  , [8,0,3,6],   [1,5,6,8],   [6,10,0,3],  [10,0,3,6]
  , [6,10,0,1],  [5,6,8,1],   [0,3,5,9],   [11,3,6,9]
  ]

-- ══════════════════════════════════════════════════════════
-- VERSION 1 — two hands, whole bars
-- ══════════════════════════════════════════════════════════
-- Left hand: the root, two octaves down, warm and held.
-- Right hand: the full 4-note upper structure, flow-voiced —
-- the seam-aware cyclic DP holds common tones across every bar
-- AND across the loop wrap.

:{
ballad s = do
  let k = iK tempo [at 0 1 1 s] (rep s 1)
  mapM_ id [hush, setbpm tempo
    , (d07 $ stack
        [ arrange (0,1) k (-9,9) T root (overlapF 0) ["~", "[0]/4"] |- oct 2 |* vel 0.6
        , arrange (0,1) k (-9,9) T flow (overlapF 0) ["~", "[0,1,2,3]/4"] |* vel 0.45
        ] # ch 07 |= legato 3.9)
    ]
:}

ballad sixteen

-- ══════════════════════════════════════════════════════════
-- VERSION 2 — add a singing top line
-- ══════════════════════════════════════════════════════════
-- A third voice above the structure: the voicing's top tone
-- (degree 3), lifted an octave — whole note one bar, split in
-- two the next, so it breathes against the static harmony.
-- Degree 4 wraps to the voicing's bass an octave up, so the
-- split bars fall by a large warm interval.

:{
ballad' s = do
  let k = iK tempo [at 0 1 1 s] (rep s 1)
  mapM_ id [hush, setbpm tempo
    , (d07 $ stack
        [ arrange (0,1) k (-9,9) T root (overlapF 0) ["~", "[0]/4"] |- oct 2 |* vel 0.6
        , arrange (0,1) k (-9,9) T flow (overlapF 0) ["~", "[0,1,2,3]/4"] |* vel 0.42
        , arrange (0,1) k (-9,9) T flow (overlapF 0) ["~", "<[3] [3 2]>/4"] |+ oct 1 |* vel 0.55
        ] # ch 07 |= legato 3.9)
    ]
:}

ballad' sixteen

hush

-- ══════════════════════════════════════════════════════════
-- VERSION 3 — the machine arrangement ("robots")
-- ══════════════════════════════════════════════════════════
-- The same sixteen bars, away from the ballad and toward
-- Kraftwerk: repeated 8ths on the jazz bass (ch 8) held low in
-- bass-guitar territory, the electro machine beat from the
-- drumpats library (kgrv interface, ch 9, straight), the EP
-- harmony as a hypnotic 16th arpeggio, and the composed melody a
-- shade louder with light passing-tone ornaments. 118 BPM,
-- legato throughout.
--
-- Load the drum pattern first (defines kickpat/…/kgrv):
--   :script live/drumpats/electro/electro.tidal
-- (in an editor, evaluate the file's blocks; kgrv sends the kit
-- on ch 9.)

import qualified Data.Map.Strict as DMap

:{
-- Fold any note below the floor up an octave: the bass sits as
-- low as the instrument range allows and steps up only where it
-- would fall off the bottom.
raiseFloor fl = fmap (DMap.adjust bump "note")
  where bump (VN (Note n)) = VN (Note (if n < fl then n + 12 else n))
        bump v = v
:}

-- Dynamics: `ramp` swells the whole piece across one pass of the
-- 16-bar form (64 cycles), resetting at the wrap; `bassdyn`
-- accents the bass 8ths where the electro kick lands (positions
-- 1, 4, 6 and the pushed 7th) so bass and kick breathe together.
ramp = slow 64 $ range 0.78 1.08 saw
bassdyn = "[0.62 0.48 0.48 0.6 0.48 0.6 0.58 0.48]/4"

:{
robots s = do
  let k = iK 118 [at 0 1 1 s] (rep s 1)
  mapM_ id [hush, setbpm 118
    , (d07 $ stack
        [ arrange (0,1) k (-9,9) T flow (overlapF 0) ["~", "[0 1 2 3]"] |* vel 0.38 |= legato 0.85
        , arrange (0,1) k (-9,9) T flow (overlapF 0) ["~", "<[3] [3 2] [[4 5] 4] [3 2] [3 [3 4 3 2]] [2 3] [4 3] [2 [2 3 2 1]]>/4"] |+ oct 1 |* vel 0.65 |= legato 2.2
        ] # ch 07 |* vel ramp)
    , (d08 $ raiseFloor (-20) $ arrange (0,1) k (-9,9) T root (overlapF 0) ["~", "[0 0]"] # ch 08 |- oct 2 |= vel bassdyn |* vel ramp |= legato 0.9)
    , kgrv id k (0.7 * ramp)
    ]
:}

robots sixteen

hush

-- ══════════════════════════════════════════════════════════
-- SUGGESTED NEXT STEPS
-- ══════════════════════════════════════════════════════════
-- HARMONY
--  * Bars 11-14 sit still on the Gb sonority — beautiful once,
--    long twice. Try regenerating 12-14 inside the flat key with
--    more motion:
--      s' <- seek "*" $ tonal (hcKey "5b" $ hContext) $ entropy 0.4 $ genFrom sixteen 12 14
--  * A true ii-V turnaround: pin bar 15 to C only —
--      s' <- seek "*" $ tonal (hcRoots "c" $ hcKey "2b" $ hContext) $ genFrom sixteen 15 15
--    (bar 16's F7 already points home).
--  * Tritone-sub the final approach: hand-splice a B7 at bar 16
--      via fromChords [[11,3,6,9]] and fuse/excerpt — chromatic
--      slide B7 → Bb at the wrap.
--  * (Applied in the frozen take) bar 8 darkened to a plain D 7
--    ([[2,6,9,0]]); for a true D 7b9 use [[2,6,0,3]] — D F# C Eb.
--
-- MELODY (top line, one octave up; whole notes or half-bars)
--  * V2's contour is derived (top chord tone). To COMPOSE one
--    instead: replace the third arrange with explicit degrees —
--      "<[3] [3 2] [4] [3 2] [3] [2 3] [4 3] [2]>/4"
--    reads as an 8-bar phrase, one element per bar (whole) or
--    two (half-bar), degrees re-realising against each chord.
--  * Half-bar suspensions: repeat the PREVIOUS bar's top degree
--    for the first half, resolve in the second — "[4 3]" over a
--    chord whose 4th degree is the last bar's common tone.
--  * The B section wants the melody to fall as the harmony
--    flattens: try degrees 4-4-3-3-2-2 across bars 9-14, then
--    let bars 15-16 rise 3-4 into the wrap.
--
-- ENHARMONIC NOTE
--  The original take printed bars 12-14 as F# maj7 in the middle
--  of a five-flat neighbourhood — the per-bar spelling inference
--  flipped sides mid-region even though the root pitch class
--  never moved (Gb 6b5 → "F#" maj7b5: one upper tone changed).
--  Addressed in the engine after this piece was frozen, in
--  precedence order: (1) a declared key signature (hcKey "2b",
--  "5b", "3#", note names) fixes the spelling side for the whole
--  walk; (2) while the root pitch class stands still, the
--  spelling stands still (walk AND fromChords); (3) ambiguous
--  patterns adopt the prior side; (4) otherwise infer from
--  content. Residual (deliberate): hand material with a root
--  CHANGE still infers independently and can land on the wrong
--  side when the chord content straddles the inference tables'
--  first-match ordering — bar 10 above is the live example. Not
--  fully solvable deterministically; the declared-key path is.
