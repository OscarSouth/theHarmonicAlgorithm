//# MONONOKE CC->MPE BRIDGE
//# 8 CC faders (ch1, CC102-109) -> 8 Mononoke voices via MPE
//# fader >0 = voice on, volume tracks fader (MPE Y-axis/CC74); fader =0 = voice off.
//# No envelope retrigger while sustaining. Set Mononoke to MPE mode.

@OnLoad
	ShowLayout 4
	SetShortName {MNK8}

	if Unassigned in_channel
		in_channel   = 0     // faders arrive on MIDI ch 1 (0-indexed 0)
		base_cc      = 102   // first fader CC; faders = 102..109
		base_note    = 60    // voice 0 note; voices = 60..67
		num_faders   = 8
		// MPE: master ch 0, member channels start at 1 (lower zone)
		base_member  = 1     // fader i -> member channel (base_member + i)
		// Y-axis volume tracking is CC74 (MPE standard; = Mononoke Y dimension)
		y_cc         = 74
		// Fixed onset velocity = full headroom. CC74 (fader) then carries the whole
		// sustained dynamic. Because Y is *relative* to initial velocity, a high onset
		// gives CC74 the most room to work. Lower this if the top of the fader saturates.
		onset_vel    = 127

		// aux controls forwarded untouched for AUM MIDI-learn (fader 110 + encoders 111-119)
		fwd_base     = 110
		fwd_count    = 10

		FillArray voice_on, 0, num_faders   // per-fader on/off state
	endif
@End

@Description
	MONONOKE CC->MPE bridge.
	8 faders on MIDI ch1 (CC 102-109) play Mononoke's 8 voices via MPE.
	Fader up = voice sounds and its volume follows the fader (MPE Y-axis).
	Fader to 0 = voice off. Moving a fader does not retrigger the attack.
	>> Set Mononoke to MPE mode and route this script's output into it.
@End

@OnMidiCC
	if MIDIChannel = in_channel
		if MIDIByte2 >= base_cc and MIDIByte2 <= (base_cc + num_faders - 1)
			// fader -> MPE voice
			i      = MIDIByte2 - base_cc
			member = base_member + i
			note   = base_note + i
			level  = MIDIByte3

			if level > 0
				if voice_on[i] = 0
					// rising edge: trigger the voice at full onset headroom
					SendMIDINoteOn member, note, onset_vel
					voice_on[i] = 1
					Log {voice }, i, { ON  note }, note
				endif
				// track volume continuously via MPE Y-axis (no retrigger)
				SendMIDICC member, y_cc, level
				Log {voice }, i, { level }, level
			else
				if voice_on[i] = 1
					SendMIDINoteOff member, note, 0
					voice_on[i] = 0
					Log {voice }, i, { OFF}
				endif
			endif

		elseif MIDIByte2 >= fwd_base and MIDIByte2 <= (fwd_base + fwd_count - 1)
			// aux control -> forward untouched so AUM can MIDI-learn it
			SendMIDICC MIDIChannel, MIDIByte2, MIDIByte3
			Log {CC }, MIDIByte2, { = }, MIDIByte3
		endif
	endif
@End
